APP_NAME=diagnose-agent
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# LangGraph Agent 短期记忆（Postgres Checkpointer，与 MySQL 聊天库分离）
# docker: postgres/123456@5432/langgraph_mem
LANGGRAPH_DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/langgraph_mem
AGENT_MEMORY_MAX_MESSAGES=20

# 业务只读库（后续接入排查 SQL，切勿给写权限）
# BIZ_READONLY_DATABASE_URL=postgresql+asyncpg://readonly:***@biz-host:5432/biz_db

# ---- OpenAI 兼容网关（对应 Spring AI openai 配置）----
OPENAI_BASE_URL=http://newapi.gtech.asia:3001/v1
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TEMPERATURE=0.7
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 默认聊天模型 key：gpt-sol | qwen2.5-7b（带图：PaddleOCR→qwen）
DEFAULT_CHAT_MODEL=gpt-sol

# ---- Milvus（仅 Docker，不要用 MILVUS_URI 这个名字）----
DIAGNOSE_MILVUS_URI=http://127.0.0.1:19530
DIAGNOSE_MILVUS_TOKEN=
DIAGNOSE_MILVUS_COLLECTION=wt_code_chunks
MILVUS_EMBEDDING_DIM=1024
MILVUS_EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=batiai/qwen3-embedding:0.6b
# 本地聊天模型（与 ollama list 名称一致）
OLLAMA_CHAT_MODEL_QWEN=qwen2.5:7b-instruct-q4_K_M
# 图片文字识别：pip install paddlepaddle paddleocr opencv-python-headless pillow

# ---- MySQL（SQLAlchemy + PyMySQL，不自动建表）----
# 对应 Java:
# jdbc:mysql://localhost:3306/diagnose-agent?...
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=diagnose-agent
MYSQL_CHARSET=utf8mb4
