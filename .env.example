APP_NAME=diagnose-agent
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# 本系统库（工单 / LangGraph checkpoint），骨架阶段可先不用
DATABASE_URL=postgresql+asyncpg://diagnose:diagnose@127.0.0.1:5432/diagnose_agent

# 业务只读库（后续接入排查 SQL，切勿给写权限）
# BIZ_READONLY_DATABASE_URL=postgresql+asyncpg://readonly:***@biz-host:5432/biz_db

# ---- OpenAI 兼容网关（对应 Spring AI openai 配置）----
OPENAI_BASE_URL=http://newapi.gtech.asia:3001/v1
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TEMPERATURE=0.7
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Milvus（仅 Docker，不要用 MILVUS_URI 这个名字）----
DIAGNOSE_MILVUS_URI=http://127.0.0.1:19530
DIAGNOSE_MILVUS_TOKEN=
DIAGNOSE_MILVUS_COLLECTION=diagnose_code_chunks
MILVUS_EMBEDDING_DIM=1536
# openai=走网关 Embedding；local_hash=仅测连通（检索质量差）
MILVUS_EMBEDDING_PROVIDER=local_hash
